# SahiSupply environment configuration. Copy to .env and adjust.
# Never commit real credentials.

# development | production | test
APP_ENV=development

# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas (example shape, fill in your own user/password/cluster):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sahisupply

# Milliseconds to wait for MongoDB before falling back to the read-only synthetic snapshot
MONGODB_TIMEOUT_MS=2000

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Solver time limit (seconds) for the batch-level MILP
SOLVER_TIME_LIMIT_S=10

# Synthetic data seed
DATA_SEED=42

# Optional: set to let the chat assistant answer with Claude (claude-opus-5-5).
# Without it, the built-in assistant answers from the same plan data.
# ANTHROPIC_API_KEY=
